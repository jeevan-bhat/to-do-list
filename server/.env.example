# ------------------------------------------------------------------
# Server configuration
# Copy this file to ".env" and adjust the values as needed:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
# ------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# MongoDB connection string.
# - Local MongoDB (default):   mongodb://127.0.0.1:27017/notesapp
# - MongoDB Atlas (cloud):     mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/notesapp
MONGODB_URI=mongodb://127.0.0.1:27017/notesapp

# If MONGODB_URI can't be reached, the server falls back to an in-memory
# MongoDB so the app still runs (great for quick demos / assignments).
# Set this to "false" to disable the fallback and fail loudly instead.
USE_MEMORY_DB_FALLBACK=true

# Origin allowed to call this API (your React dev server).
# Vite's default dev port is 5173.
CLIENT_ORIGIN=http://localhost:5173
